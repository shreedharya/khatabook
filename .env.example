# Create your MSG91 credentials and an approved SMS Flow in the MSG91 dashboard.
# Copy this file to .env and replace the example template ID with your own.
MSG91_AUTH_KEY=replace-with-your-msg91-auth-key
MSG91_TEMPLATE_ID=replace-with-your-approved-flow-template-id

# These names must match the variable keys in your MSG91 Flow template.
MSG91_NAME_VARIABLE=VAR1
MSG91_BALANCE_VARIABLE=VAR2
